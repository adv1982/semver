    "agent_1": "Qwen3-VL-8B (triagem rápida + YOLO v11)",
    "agent_2": "Qwen3-VL-30B-A3B (análise intermediária)",
    "agent_3": "InternVL3-78B (análise profunda)",
    "central_brain": "Llama 3.1 405B via Petals (consolidação + laudo)"
  },
