# Copie para .env e preencha os valores

# Senha de acesso ao chat Lilith
LILITH_PASSWORD=sua_senha_aqui

# Chave de busca dark web (Onion Search)
ONION_SEARCH_KEY=sk-sua_chave_aqui

# Chave Google Search (SerpAPI) - opcional
SERPAPI_KEY=sua_chave_aqui

# Porta do servidor Flask
PORT=5000

# Modelo Petals (não altere sem autorização)
PETALS_MODEL=nicoboss/Hermes-3-Llama-3.1-405B-Uncensored

# Tor SOCKS proxy
TOR_PROXY=socks5h://127.0.0.1:9050

# Diretório da memória persistente
MEMORY_PATH=./memory_db

# Repositório Git para auto-evolução
GIT_REPO_PATH=..
